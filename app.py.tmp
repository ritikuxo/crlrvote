from flask import Flask, render_template, request, redirect, url_for, session, flash
from werkzeug.security import generate_password_hash, check_password_hash
from werkzeug.utils import secure_filename
import sqlite3
import os
import re
from datetime import datetime

app = Flask(__name__)
app.secret_key = 'college-election-secret-key-2026'
app.config['UPLOAD_FOLDER'] = 'static/uploads'
app.config['MAX_CONTENT_LENGTH'] = 2 * 1024 * 1024  # 2MB max file size

ALLOWED_EXTENSIONS = {'png', 'jpg', 'jpeg', 'gif'}

# Simple admin credentials (change these in production)
ADMIN_USERNAME = 'HODCSE'
ADMIN_PASSWORD_HASH = generate_password_hash('HODCSE@123')

def get_db_connection():
    conn = sqlite3.connect('database.db')
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_db_connection()
    conn.execute('''
        CREATE TABLE IF NOT EXISTS candidates (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            roll_no TEXT NOT NULL UNIQUE,
            department TEXT NOT NULL,
            year TEXT NOT NULL,
            photo_filename TEXT,
            password_hash TEXT NOT NULL,
            status TEXT DEFAULT 'pending',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # Migration: add status column if it doesn't exist (for existing databases)
    try:
        conn.execute('ALTER TABLE candidates ADD COLUMN status TEXT DEFAULT "pending"')
    except sqlite3.OperationalError:
        pass  # Column already exists

    # Migration: add post column if it doesn't exist (for existing databases)
    try:
        conn.execute('ALTER TABLE candidates ADD COLUMN post TEXT DEFAULT "CR"')
    except sqlite3.OperationalError:
        pass  # Column already exists

    # Migration: add can_register_again column if it doesn't exist (for existing databases)
    try:
        conn.execute('ALTER TABLE candidates ADD COLUMN can_register_again INTEGER DEFAULT 0')
    except sqlite3.OperationalError:
        pass  # Column already exists

    # Create voters table
    conn.execute('''
        CREATE TABLE IF NOT EXISTS voters (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            roll_no TEXT NOT NULL UNIQUE,
            name TEXT NOT NULL,
            department TEXT,
            year TEXT,
            has_voted INTEGER DEFAULT 0,
            voted_at TIMESTAMP,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')

    # Create votes table
    conn.execute('''
        CREATE TABLE IF NOT EXISTS votes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            roll_no TEXT NOT NULL,
            cr_candidate_id INTEGER,
            lr_candidate_id INTEGER,
            voted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (roll_no) REFERENCES voters(roll_no),
            FOREIGN KEY (cr_candidate_id) REFERENCES candidates(id),
            FOREIGN KEY (lr_candidate_id) REFERENCES candidates(id)
        )
    ''')

    conn.commit()
    conn.close()

def allowed_file(filename):
    return '.' in filename and filename.rsplit('.', 1)[1].lower() in ALLOWED_EXTENSIONS

# Initialize database on startup
init_db()

# Ensure upload folder exists
os.makedirs(app.config['UPLOAD_FOLDER'], exist_ok=True)

@app.route('/')
def index():
    return render_template('index.html')

# ---------- CANDIDATE REGISTRATION ----------
@app.route('/candidate/register', methods=['GET', 'POST'])
def candidate_register():
    if request.method == 'POST':
        name = request.form.get('name')
        roll_no = request.form.get('roll_no')
        department = request.form.get('department')
        year = request.form.get('year')
        post = request.form.get('post')
        password = request.form.get('password')
        confirm_password = request.form.get('confirm_password')
        photo = request.files.get('photo')

        # Validation
        if not all([name, roll_no, department, year, post, password, confirm_password]):
            flash('All fields are required.', 'error')
            return redirect(url_for('candidate_register'))

        if post not in ['CR', 'LR']:
            flash('Please select a valid post (CR or LR).', 'error')
            return redirect(url_for('candidate_register'))

        if password != confirm_password:
            flash('Passwords do not match.', 'error')
            return redirect(url_for('candidate_register'))

        if len(password) < 6:
            flash('Password must be at least 6 characters.', 'error')
            return redirect(url_for('candidate_register'))

        photo_filename = None
        if photo and photo.filename != '':
            if not allowed_file(photo.filename):
                flash('Only image files (png, jpg, jpeg, gif) are allowed.', 'error')
                return redirect(url_for('candidate_register'))
            photo_filename = secure_filename(f"{roll_no}_{photo.filename}")

        conn = get_db_connection()
        try:
            password_hash = generate_password_hash(password)
            conn.execute(
                'INSERT INTO candidates (name, roll_no, department, year, post, photo_filename, password_hash, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
                (name, roll_no, department, year, post, photo_filename, password_hash, 'pending')
            )
            conn.commit()
            flash('Registration successful! Your nomination is pending admin approval.', 'info')
            return redirect(url_for('candidate_login'))
        except sqlite3.IntegrityError:
            flash('A candidate with this roll number already exists.', 'error')
            return redirect(url_for('candidate_register'))
        finally:
            # Save photo file if there is one
            if photo_filename:
                photo.seek(0)
                photo.save(os.path.join(app.config['UPLOAD_FOLDER'], photo_filename))
            conn.close()

    return render_template('candidate_register.html')

# ---------- CANDIDATE LOGIN ----------
@app.route('/candidate/login', methods=['GET', 'POST'])
def candidate_login():
    if request.method == 'POST':
        roll_no = request.form.get('roll_no')
        password = request.form.get('password')

        if not roll_no or not password:
            flash('Please enter both roll number and password.', 'error')
            return redirect(url_for('candidate_login'))

        conn = get_db_connection()
        candidate = conn.execute('SELECT * FROM candidates WHERE roll_no = ?', (roll_no,)).fetchone()
        conn.close()

        if candidate and check_password_hash(candidate['password_hash'], password):
            session['candidate_id'] = candidate['id']
            session['candidate_name'] = candidate['name']
            session['candidate_roll_no'] = candidate['roll_no']
            flash(f'Welcome back, {candidate["name"]}!', 'success')
            return redirect(url_for('candidate_dashboard'))
        else:
            flash('Invalid roll number or password.', 'error')
            return redirect(url_for('candidate_login'))

    return render_template('candidate_login.html')

# ---------- CANDIDATE DASHBOARD ----------
@app.route('/candidate/dashboard')
def candidate_dashboard():
    if 'candidate_id' not in session:
        flash('Please login to access your dashboard.', 'error')
        return redirect(url_for('candidate_login'))

    conn = get_db_connection()
    candidate = conn.execute('SELECT * FROM candidates WHERE id = ?', (session['candidate_id'],)).fetchone()
    conn.close()

    return render_template('candidate_dashboard.html', candidate=candidate)

